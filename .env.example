# ===========================================
# Configuração de Frete - Flor de Menina
# ===========================================

# CEP de origem do envio (showroom em Palmas-TO)
SHIPPING_ORIGIN_CEP=77015000

# -------------------------------------------
# Melhor Envio (RECOMENDADO para frete real)
# -------------------------------------------
# Cadastre-se gratuitamente em https://melhorenvio.com.br
# Gere um token em: Painel > Integrações > Token de acesso
# Com o token, o site consulta preços REAIS de Correios, Jadlog, etc.
MELHOR_ENVIO_TOKEN=

# Use "true" para testar no ambiente sandbox (sem cobranças reais)
MELHOR_ENVIO_SANDBOX=false
